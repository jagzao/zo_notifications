# ===========================================
# ZO Notifications - Environment Variables
# ===========================================

# API Configuration
# -----------------
API_PORT=3000
NODE_ENV=production
API_KEY_SECRET=change-this-to-a-random-secret-key

# Redis Configuration
# -------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password

# PostgreSQL Configuration
# -------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=notifications
POSTGRES_USER=notifier
POSTGRES_PASSWORD=change-this-postgres-password

# Discord Configuration
# ----------------------
# Crea un webhook en: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
DISCORD_ERROR_ROLE_ID=
DISCORD_USERNAME=ZO Notifications
DISCORD_AVATAR_URL=

# Push Notifications (Ntfy.sh)
# -----------------------------
# Opción 1: Usar servidor público ntfy.sh
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=zo-notifications-your-unique-topic

# Opción 2: Self-hosted (descomentar si usas ntfy en docker-compose)
# NTFY_SERVER=http://ntfy:80
# NTFY_TOPIC=notifications

# Firebase Cloud Messaging (Alternativa a Ntfy)
# ----------------------------------------------
# Descomentar si prefieres usar Firebase
# FCM_SERVER_KEY=
# FCM_DEVICE_TOKEN=

# Security Configuration
# ----------------------
# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Request limits
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT=30000

# CORS (lista separada por comas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# SSL/TLS (para nginx)
# --------------------
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Logging
# -------
LOG_LEVEL=info
LOG_FORMAT=json

# Queue Configuration
# -------------------
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000

# Notification Settings
# ---------------------
# Agrupar notificaciones similares (en segundos)
NOTIFICATION_GROUP_WINDOW=300

# Máximo de push notifications por hora
MAX_PUSH_PER_HOUR=10

# Silenciar notificaciones durante estas horas (24h format)
QUIET_HOURS_START=22
QUIET_HOURS_END=7

# Timezone
TZ=America/Mexico_City

# Health Check
# ------------
HEALTH_CHECK_INTERVAL=30000

# Database Backup (opcional)
# --------------------------
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
